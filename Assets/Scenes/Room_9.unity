  artifactSprite: {fileID: -2594383343736811624, guid: f55156a3943151c47b4cdc7b3a9f4435, type: 3}
  plaqueTitle: ...
  plaqueDescription: A traditional polychordal bamboo tube zither featuring strings
    etched directly from the bamboo's outer skin, supported by wooden bridges to
    accompany sacred epic chants and celebrations.
  artifactInspectionDescription: Hollow whole bamboo tube fitted with parallel strings
    raised on carved wooden fret bridges. When plucked, the resonant bamboo chamber
    produces rich, melodic percussive harmonies.
